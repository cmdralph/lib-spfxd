%rename cpp_options spfxd_old_cpp_options

*cpp_options:
-nostdinc -isystem @INC@ -isystem @ARCHINC@ -isystem @CCINC@ %(spfxd_old_cpp_options)

*cc1:
%(cc1_cpu) -nostdinc -isystem @INC@ -isystem @ARCHINC@ -isystem @CCINC@

*link_libgcc:
-L@LIB@

*libgcc:
libgcc.a%s %:if-exists(libgcc_eh.a%s)

*lib:
-lc

*startfile:
%{shared:;static:@LIB@/crt1.o;static-pie:@LIB@/rcrt1.o;!no-pie:@LIB@/Scrt1.o;:@LIB@/crt1.o} @LIB@/crti.o %{static:crtbeginT.o%s;shared|static-pie|!no-pie:crtbeginS.o%s;:crtbegin.o%s}

*endfile:
%{static:crtend.o%s;shared|static-pie|!no-pie:crtendS.o%s;:crtend.o%s} @LIB@/crtn.o

*link:
-m @EMUL@ %{!r:--build-id} %{!static|static-pie:--eh-frame-hdr} -nostdlib %{!shared:%{!static:%{!static-pie:-dynamic-linker @LIB@/libc.so}}} %{shared:-shared} %{static:-static} %{static-pie:-static -pie --no-dynamic-linker -z text} %{rdynamic:-export-dynamic} %{!r:--gc-sections} --hash-style=both

*esp_link:


*esp_options:


*esp_cpp_options:


